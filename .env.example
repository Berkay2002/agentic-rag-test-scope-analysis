# LangSmith Configuration (Optional - for observability)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=agrag-test-scope-analysis

# Ragas Configuration (Optional)
RAGAS_MODEL=gemini-3-flash-preview
RAGAS_MAX_RETRIES=3
RAGAS_ENABLED=false

# LangSmith Experiments (Optional)
LANGSMITH_EXPERIMENTS_ENABLED=false
LANGSMITH_DATASET_VERSION=v1
LANGSMITH_MAX_CONCURRENCY=10

# Providers (Required)
# Choose which chat and embedding providers to use: google | openai
LLM_PROVIDER=google
EMBEDDINGS_PROVIDER=google

# Google Generative AI (Required if LLM_PROVIDER=google)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-3-flash-preview
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_THINKING_LEVEL=low  # optional: low/medium/high/minimal (Gemini 3)
GOOGLE_THINKING_BUDGET=256  # optional: legacy token budget (avoid when thinking_level is set)

# OpenAI-compatible endpoint (Required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_ORGANIZATION=your_org_id

# OpenAI-compatible embeddings (Required if EMBEDDINGS_PROVIDER=openai)
# OPENAI_EMBEDDING_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_EMBEDDING_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_EMBEDDING_ORGANIZATION=your_org_id

# Neo4j Configuration (Required)
# For Neo4j Aura (cloud): use neo4j+s:// protocol
# For local Neo4j: use bolt://localhost:7687
NEO4J_URI=neo4j+s://your_instance_id.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
AURA_INSTANCEID=your_instance_id
AURA_INSTANCENAME=your_instance_name

# PostgreSQL/Neon Configuration (Required)
# Option 1: Use Neon connection string
NEON_CONNECTION_STRING=postgresql://user:password@host:5432/dbname?sslmode=require

# Option 2: Use individual PostgreSQL settings
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_postgres_password_here
# POSTGRES_DATABASE=agrag

# Agent Configuration (Optional - has defaults)
MAX_TOOL_CALLS=10
MAX_MODEL_CALLS=20
AGENT_TEMPERATURE=1.0

# Batch Processing (Optional)
# Set to true to bypass real LLM/DB calls during batch processing.
AGRAG_BATCH_MOCK=false

# Vector Search Configuration (Optional - has defaults)
VECTOR_SEARCH_SIMILARITY_THRESHOLD=0.7
GRAPH_TRAVERSAL_MAX_DEPTH=3
EMBEDDING_DIMENSIONS=768
